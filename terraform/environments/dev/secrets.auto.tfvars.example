# Copy to secrets.auto.tfvars (gitignored) and set lab credentials.
# Do not commit real passwords.
#
#   cp secrets.auto.tfvars.example secrets.auto.tfvars
#
# Or export for one shell:
#   export TF_VAR_db_username='appuser'
#   export TF_VAR_db_password='YourStrongPasswordHere123!'
#
# Note: committed terraform.tfvars is tracked by Git — keep secrets out of it.

db_username = "appuser"
db_password = "YourTemporaryPassword123!"
